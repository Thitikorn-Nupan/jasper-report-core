	<property name="net.sf.jasperreports.print.create.bookmarks" value="false"/>
	<query language="SQL"><![CDATA[SELECT l.phone , l.province , l.district ,
	sd.student_fullname , sd.student_id , student_grade
	FROM one_to_many_2.locations AS l 
	JOIN one_to_many_2.students AS sd 
	ON sd.student_id = l.key_student_id
	ORDER BY sd.student_id;]]></query>
